# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_WEBHOOK_URL=your-webhook-url

# AI Configuration (product photo analysis)
# Primary provider: OpenAI. Set a monthly spend limit in the OpenAI dashboard.
OPENAI_API_KEY=<your OpenAI API key>
# Optional: model id (default gpt-5-mini); a cheaper nano-class model also works
OPENAI_VISION_MODEL=gpt-5-mini
# Optional: reasoning effort for reasoning models (default low; "none" to omit the parameter)
OPENAI_REASONING_EFFORT=low
# Optional fallback provider: used only if OpenAI fails
GEMINI_API_KEY=<your Gemini API key>

# AI studio photos in the Telegram bot (white background + mannequin), uses OPENAI_API_KEY
# Set to false to turn the feature off
AI_PHOTOS_ENABLED=true
# Products per store per day that get AI photos
AI_PHOTO_DAILY_LIMIT=10
# Optional: image model and quality (low | medium | high)
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
# Optional: public site URL (links in bot/emails, background photo jobs). Default https://modora.uz
NEXT_PUBLIC_SITE_URL=https://modora.uz

# Other Configuration
NODE_ENV=development
